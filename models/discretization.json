                    "min": 100.0,
                    "max": 140.0,
                    "inclusive_left": true,
                    "inclusive_right": true
                },
                "clinical_safety_rule": "Duy trì lối sống cân bằng, khuyến khích rèn luyện thể lực vừa (MODERATE Exercise)"
            },
            {
                "bin_id": 3,
                "label": "141 - 180 mg/dL",
                "clinical_category": "Đỉnh sau ăn chấp nhận được (Acceptable Postprandial)",
                "range": {
                    "min": 140.0,
                    "max": 180.0,
                    "inclusive_left": false,
                    "inclusive_right": true
                },
                "clinical_safety_rule": "Cắt giảm tinh bột bữa kế tiếp (LOW Carb), vận động thể lực vừa để hỗ trợ điều hòa đường huyết"
            },
            {
                "bin_id": 4,
                "label": "181 - 250 mg/dL",
                "clinical_category": "Tăng đường huyết cao (Elevated Hyperglycemia)",
                "range": {
                    "min": 180.0,
                    "max": 250.0,
                    "inclusive_left": false,
                    "inclusive_right": true
                },
                "clinical_safety_rule": "Cấm ăn High Carb (RULE_03), ưu tiên Low Carb, vận động vừa và nhắc đo đường huyết"
            },
            {
                "bin_id": 5,
                "label": "> 250 mg/dL",
                "clinical_category": "Tăng đường huyết rất cao (Severe Hyperglycemia / DKA Risk)",
                "range": {
                    "min": 250.0,
                    "max": 1000.0,
                    "inclusive_left": false,
                    "inclusive_right": true
                },
                "clinical_safety_rule": "Cấm vận động thể lực (RULE_02: tránh nguy cơ toan ceton), cấm ăn High Carb (RULE_03), bắt buộc nhắc đo (RULE_05)"
            }
        ],

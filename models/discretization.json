                    "max": 100.0,
                    "inclusive_left": true,
                    "inclusive_right": false
                },
                "clinical_safety_rule": "Cấm vận động thể lực (RULE_01), ưu tiên ăn mức tinh bột vừa phải (Moderate Carb)"
            },
            {
                "bin_id": 2,
